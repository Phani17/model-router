{
  "name": "model-router",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @model-router/api --filter @model-router/web dev",
    "dev:api": "pnpm --filter @model-router/api dev",
    "dev:web": "pnpm --filter @model-router/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build"
  }
}
