DIGITALOCEAN_MODEL_ACCESS_KEY=
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run
PORT=8080
HOST=0.0.0.0

# PoC token bucket. A 4-model comparison consumes 4 units.
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=0.3333333333

# Privacy-safe persistence; disabled for dependency-free API development.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://model_router:model_router@localhost:5432/model_router?schema=public

# Optional features are off by default so the PoC quality baseline is unchanged.
FEATURE_TOKEN_COST_GOVERNANCE=false
FEATURE_EXACT_CACHE=false
FEATURE_SEMANTIC_CACHE=false
FEATURE_EVALS=false
FEATURE_OBSERVABILITY=false
FEATURE_RECOMMENDATIONS=false
FEATURE_DEV_IDENTITY=false
CACHE_FINGERPRINT_KEY=replace-with-at-least-32-random-characters

# Provider-neutral OIDC/OAuth 2.0 SSO. Enable in shared/production environments.
AUTH_ENABLED=false
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=model-router-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
